    // ============================================================
    // PROCESAR DICTADO
    // ============================================================
    function procesarDictado() {
        const input = document.getElementById('input-dictado');
        const texto = input.value.trim();

        if (!texto || texto.length < 3) {
            toast('Escribe o dicta algo primero', 'warning');
            return;
        }

        const partes = dividirEnTareas(texto);
        if (partes.length === 0) {
            toast('No se detectaron tareas', 'warning');
            return;
        }

        let tareasAñadidas = 0;
        let pedidosAñadidos = 0;

        partes.forEach(p => {
            const pedido = detectarPedido(p.original);

            if (pedido.esPedido) {
                pedidosEnviados.push({
                    id: Date.now() + Math.random(),
                    producto: pedido.producto,
                    proveedor: pedido.proveedor,
                    textoOriginal: p.original,
                    enviado: new Date().toISOString()
                });
                pedidosAñadidos++;
                return;
            }

            const { fecha } = detectarFecha(p.original);
            const urgente = esUrgente(p.texto);

            tareas.push({
                id: Date.now() + Math.random(),
                texto: p.texto,
                fecha: fecha || null,
                urgente: urgente,
                hecha: false,
                creada: new Date().toISOString()
            });
            tareasAñadidas++;
        });

        guardar();
        renderTareas();
        renderPedidos();
        limpiarDictado();

        const msgs = [];
        if (tareasAñadidas > 0) msgs.push(`${tareasAñadidas} tarea${tareasAñadidas !== 1 ? 's' : ''} en agenda`);
        if (pedidosAñadidos > 0) msgs.push(`${pedidosAñadidos} pedido${pedidosAñadidos !== 1 ? 's' : ''} enviado${pedidosAñadidos !== 1 ? 's' : ''}`);

        if (msgs.length > 0) {
            toast('✅ ' + msgs.join(' · '), 'success');
        } else {
            toast('No se pudo procesar nada', 'warning');
        }
    }

    // ============================================================
    // RENDERIZADO DE TAREAS
    // ============================================================
    function renderTareas() {
        const contenedor = document.getElementById('lista-tareas');

        let filtradas = [...tareas];
        if (filtroActual === 'pendientes') filtradas = filtradas.filter(t => !t.hecha);
        if (filtroActual === 'hechas') filtradas = filtradas.filter(t => t.hecha);

        const total = tareas.length;
        const pend = tareas.filter(t => !t.hecha).length;
        document.getElementById('contador-total').textContent = 
            `${total} tarea${total !== 1 ? 's' : ''} · ${pend} pendiente${pend !== 1 ? 's' : ''}`;

        if (filtradas.length === 0) {
            contenedor.innerHTML = `
                <div class="text-center text-slate-400 py-12 bg-white rounded-2xl border border-slate-200">
                    <div class="text-5xl mb-3">${filtroActual === 'hechas' ? '✅' : '📭'}</div>
                    <div class="text-sm font-medium">
                        ${filtroActual === 'hechas' ? 'No hay tareas completadas' : 'No hay tareas pendientes'}
                    </div>
                </div>
            `;
            return;
        }

        const grupos = {};
        filtradas.forEach(t => {
            const key = t.fecha || 'SIN_FECHA';
            if (!grupos[key]) grupos[key] = [];
            grupos[key].push(t);
        });

        const claves = Object.keys(grupos).sort((a, b) => {
            if (a === 'SIN_FECHA') return 1;
            if (b === 'SIN_FECHA') return -1;
            return a.localeCompare(b);
        });

        contenedor.innerHTML = claves.map(clave => {
            const tareasDelGrupo = grupos[clave];
            const pendientes = tareasDelGrupo.filter(t => !t.hecha).length;

            let titulo, claseSep;
            if (clave === 'SIN_FECHA') {
                titulo = '📌 Sin fecha';
                claseSep = 'dia-separador sin-fecha';
            } else {
                const dia = diaSemana(clave);
                const esHoy = clave === fechaHoy();
                const esMañana = clave === sumarDias(fechaHoy(), 1);
                let prefijo = '📆';
                if (esHoy) prefijo = '🔴 HOY';
                else if (esMañana) prefijo = '🟡 MAÑANA';
                titulo = prefijo === '📆' ? `📆 ${dia} ${formatearFecha(clave)}` : `${prefijo} · ${formatearFecha(clave)}`;
                claseSep = 'dia-separador';
            }

            tareasDelGrupo.sort((a, b) => {
                if (a.urgente !== b.urgente) return a.urgente ? -1 : 1;
                return new Date(a.creada) - new Date(b.creada);
            });

            return `
                <div class="${claseSep}">
                    <span>${titulo}</span>
                    <span class="contador">${pendientes} pendiente${pendientes !== 1 ? 's' : ''}</span>
                </div>
                ${tareasDelGrupo.map(t => renderTarea(t)).join('')}
            `;
        }).join('');
    }

    function renderTarea(t) {
        const clases = ['tarea-card'];
        if (t.urgente) clases.push('urgente');
        if (t.hecha) clases.push('hecha');

        return `
            <div class="${clases.join(' ')}">
                <div class="tarea-check ${t.hecha ? 'checked' : ''}" onclick="toggleTarea(${t.id})" title="${t.hecha ? 'Marcar pendiente' : 'Marcar hecha'}">
                    ${t.hecha ? '✓' : ''}
                </div>
                <div class="tarea-contenido">
                    <div class="tarea-texto">${t.urgente ? '🚨 ' : ''}${esc(t.texto)}</div>
                    <div class="tarea-meta">
                        <div style="margin-left:auto; display:flex; gap:2px;">
                            <button class="btn-icon" onclick="editarTarea(${t.id})" title="Editar">✏️</button>
                            <button class="btn-icon danger" onclick="borrarTarea(${t.id})" title="Borrar">🗑️</button>
                        </div>
                    </div>
                </div>
            </div>
        `;
    }

