    async function editarTarea(id) {
        const t = tareas.find(x => x.id === id);
        if (!t) return;

        const { value: formData } = await Swal.fire({
            title: '✏️ Editar tarea',
            html: `
                <div style="text-align:left; font-size:14px;">
