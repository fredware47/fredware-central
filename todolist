    async function borrarTarea(id) {
        const ok = await Swal.fire({
            title: '¿Borrar esta tarea?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#dc2626',
            confirmButtonText: 'Sí, borrar',
            cancelButtonText: 'Cancelar'
        });
        if (!ok.isConfirmed) return;

        tareas = tareas.filter(t => t.id !== id);
        guardar();
        renderTareas();
        toast('🗑️ Tarea borrada', 'info');
    }

    async function borrarHechas() {
        const hechas = tareas.filter(t => t.hecha);
        if (hechas.length === 0) {
            toast('No hay tareas hechas', 'warning');
            return;
        }

        const ok = await Swal.fire({
            title: `¿Borrar ${hechas.length} tarea${hechas.length !== 1 ? 's' : ''} hecha${hechas.length !== 1 ? 's' : ''}?`,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#dc2626',
            confirmButtonText: 'Sí, borrar',
            cancelButtonText: 'Cancelar'
        });
        if (!ok.isConfirmed) return;

        tareas = tareas.filter(t => !t.hecha);
        guardar();
        renderTareas();
        toast(`🗑️ ${hechas.length} borrada${hechas.length !== 1 ? 's' : ''}`, 'info');
    }

    async function borrarPedidosEnviados() {
        if (pedidosEnviados.length === 0) {
            toast('No hay pedidos enviados', 'warning');
            return;
        }

        const ok = await Swal.fire({
            title: `¿Limpiar ${pedidosEnviados.length} pedido${pedidosEnviados.length !== 1 ? 's' : ''}?`,
            text: 'Solo se borra de esta lista. Los pedidos ya están en el módulo de pedidos.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#dc2626',
            confirmButtonText: 'Sí, limpiar',
            cancelButtonText: 'Cancelar'
        });
        if (!ok.isConfirmed) return;

        pedidosEnviados = [];
        guardar();
        renderPedidos();
        toast('🗑️ Lista de pedidos limpia', 'info');
    }

    async function borrarPedido(id) {
        pedidosEnviados = pedidosEnviados.filter(p => p.id !== id);
        guardar();
        renderPedidos();
        toast('🗑️ Pedido quitado de la lista', 'info');
    }

