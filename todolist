<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>🎤 Todo List Speech - Fredware</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='20' fill='%231e293b'/%3E%3Ctext x='50' y='68' font-size='50' text-anchor='middle' fill='%23fbbf24' font-family='Arial'%3E🎤%3C/text%3E%3C/svg%3E">
    <meta name="theme-color" content="#1e293b">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        * { -webkit-tap-highlight-color: transparent; box-sizing: border-box; }
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }

        .tarea-card {
            background: white; border: 1px solid #e2e8f0;
            border-radius: 12px; padding: 14px 16px; margin-bottom: 8px;
            transition: all 0.2s; position: relative;
            display: flex; gap: 12px; align-items: flex-start;
        }
        .tarea-card:hover { border-color: #cbd5e1; box-shadow: 0 2px 8px rgba(0,0,0,0.05); }
        .tarea-card.urgente { border-left: 4px solid #dc2626; background: #fef2f2; }
        .tarea-card.hecha { opacity: 0.55; background: #f8fafc; }
        .tarea-card.hecha .tarea-texto { text-decoration: line-through; color: #94a3b8; }
        .tarea-card.pedido { border-left: 4px solid #0ea5e9; background: #f0f9ff; }

        .tarea-check {
            width: 24px; height: 24px; border-radius: 6px;
            border: 2px solid #cbd5e1; cursor: pointer; flex-shrink: 0;
            display: flex; align-items: center; justify-content: center;
            font-size: 14px; transition: all 0.15s; background: white;
            margin-top: 2px;
        }
        .tarea-check:hover { border-color: #10b981; }
        .tarea-check.checked { background: #10b981; border-color: #10b981; color: white; }

        .tarea-contenido { flex: 1; min-width: 0; }
        .tarea-texto {
            font-size: 15px; color: #1e293b; line-height: 1.4;
            word-break: break-word; font-weight: 500;
        }
        .tarea-meta {
            font-size: 11px; color: #94a3b8; margin-top: 6px;
            display: flex; gap: 12px; flex-wrap: wrap; align-items: center;
        }

        .badge-pedido {
            display: inline-block; padding: 3px 10px; border-radius: 20px;
            font-size: 10px; font-weight: 800; letter-spacing: 0.3px;
            background: #dbeafe; color: #1e40af;
            text-transform: uppercase;
        }
        .badge-urgente {
            display: inline-block; padding: 3px 10px; border-radius: 20px;
            font-size: 10px; font-weight: 800; letter-spacing: 0.3px;
            background: #fee2e2; color: #991b1b;
            text-transform: uppercase;
        }

        .btn-icon {
            background: none; border: none; cursor: pointer;
            padding: 5px 8px; border-radius: 6px; font-size: 14px;
            transition: all 0.15s;
        }
        .btn-icon:hover { background: #f1f5f9; }
        .btn-icon.danger:hover { background: #fee2e2; }
        .btn-icon.success:hover { background: #d1fae5; }
        .btn-icon.info:hover { background: #dbeafe; }

        .input-rapido {
            width: 100%; padding: 14px 16px; font-size: 15px;
            border: 2px solid #cbd5e1; border-radius: 12px;
            background: #f8fafc; font-family: inherit;
            transition: all 0.2s;
        }
        .input-rapido:focus {
            outline: none; border-color: #1e293b; background: white;
            box-shadow: 0 0 0 3px rgba(30,41,59,0.1);
        }

        /* Botón de micrófono */
        .btn-micro {
            width: 54px; height: 54px; border-radius: 50%;
            border: none; cursor: pointer; font-size: 24px;
            display: flex; align-items: center; justify-content: center;
            transition: all 0.2s; flex-shrink: 0;
            background: #1e293b; color: white;
            box-shadow: 0 2px 8px rgba(30,41,59,0.3);
        }
        .btn-micro:hover { transform: scale(1.05); background: #334155; }
        .btn-micro.escuchando {
            background: #dc2626; animation: pulso 1.2s infinite;
        }
        .btn-micro.escuchando:hover { background: #b91c1c; }
        @keyframes pulso {
            0%, 100% { box-shadow: 0 0 0 0 rgba(220,38,38,0.6); }
            50% { box-shadow: 0 0 0 14px rgba(220,38,38,0); }
        }

        .estado-voz {
            padding: 10px 14px; border-radius: 10px; font-size: 13px;
            margin-top: 10px; display: none; text-align: center;
            font-weight: 600;
        }
        .estado-voz.visible { display: block; }
        .estado-voz.escuchando { background: #fee2e2; color: #991b1b; }
        .estado-voz.error { background: #fee2e2; color: #991b1b; }
        .estado-voz.ok { background: #d1fae5; color: #065f46; }

        .transcripcion-interina {
            font-size: 12px; color: #64748b; font-style: italic;
            margin-top: 6px; min-height: 16px;
        }

        /* Vista previa de detección */
        .preview-item {
            padding: 10px 12px; border-radius: 10px; margin-top: 8px;
            font-size: 13px; border-left: 4px solid;
            animation: fadeIn 0.2s ease;
        }
        .preview-item.tarea { background: #f0fdf4; border-color: #10b981; color: #065f46; }
        .preview-item.pedido { background: #eff6ff; border-color: #0ea5e9; color: #0c4a6e; }
        .preview-item .preview-titulo { font-weight: 700; margin-bottom: 4px; }
        .preview-item .preview-detalle { font-size: 12px; opacity: 0.85; line-height: 1.5; }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(-4px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .atag-help {
            background: #f0f9ff; border-left: 3px solid #0ea5e9;
            padding: 8px 12px; border-radius: 8px; font-size: 12px;
            color: #0c4a6e; margin-top: 8px;
        }

        .dia-separador {
            background: #1e293b; color: white; padding: 8px 14px;
            border-radius: 10px; font-weight: 900; font-size: 13px;
            text-transform: uppercase; letter-spacing: 1px;
            margin: 16px 0 8px 0; display: flex; justify-content: space-between;
            align-items: center; flex-wrap: wrap; gap: 6px;
        }
        .dia-separador.sin-fecha { background: #64748b; }
        .dia-separador .contador {
            background: rgba(255,255,255,0.2); padding: 2px 10px;
            border-radius: 20px; font-size: 11px; font-weight: 700;
        }

        .filtro-chip {
            padding: 6px 14px; border-radius: 20px; border: 1px solid #cbd5e1;
            background: white; cursor: pointer; font-size: 12px;
            font-weight: 600; transition: all 0.15s; color: #475569;
        }
        .filtro-chip:hover { border-color: #1e293b; }
        .filtro-chip.active { background: #1e293b; color: white; border-color: #1e293b; }

        /* IMPRESIÓN */
        #zona-impresion { display: none; }
        @media print {
            body > *:not(#zona-impresion) { display: none !important; }
            #zona-impresion {
                display: block !important;
                padding: 0 !important;
                margin: 0 !important;
            }
            @page { margin: 15mm; size: A4; }
            .impresion-hoja {
                font-family: 'Georgia', 'Times New Roman', serif;
                color: #000; font-size: 11pt; line-height: 1.5;
            }
        }
    </style>
</head>
<body class="bg-slate-100 text-slate-900 min-h-screen pb-24 font-sans">

    <header class="bg-white border-b border-slate-300 py-4 px-5 sticky top-0 z-50 shadow-sm">
        <div class="max-w-3xl mx-auto">
            <div class="flex justify-between items-center flex-wrap gap-3">
                <div class="flex items-center space-x-3">
                    <span class="text-3xl">🎤</span>
                    <div>
                        <h1 class="text-lg font-black tracking-tight">TODO LIST SPEECH</h1>
                        <p class="text-xs text-slate-500 font-bold tracking-wider uppercase">Dicta · Organiza · Imprime</p>
                    </div>
                </div>
                <div class="flex items-center gap-2 flex-wrap">
                    <button id="btn-usuario" class="bg-slate-100 hover:bg-slate-200 px-4 py-2 rounded-xl text-xs font-bold transition-all"></button>
                </div>
            </div>
        </div>
    </header>

    <main class="max-w-3xl mx-auto w-full px-4 mt-5 space-y-4">

        <!-- DICTADO POR VOZ -->
        <div class="bg-white border border-slate-200 rounded-2xl p-4 shadow-sm">
            <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-3">🎤 Dicta tus tareas</label>

            <div class="flex gap-3 items-start">
                <button id="btn-micro" class="btn-micro" onclick="toggleDictado()" title="Pulsa para dictar">
                    🎤
                </button>
                <div class="flex-1">
                    <textarea
                        id="input-dictado"
                        class="input-rapido"
                        rows="3"
                        placeholder='Pulsa el micrófono y habla... Ej: "Comprar a Makro atún, llamar al fontanero mañana y revisar la cámara el viernes"'
                        style="resize: vertical; min-height: 90px;"
                        oninput="previsualizarDictado()"
                    ></textarea>
                    <div id="transcripcion-interina" class="transcripcion-interina"></div>
                </div>
            </div>

            <div id="estado-voz" class="estado-voz"></div>

            <div id="preview-deteccion"></div>

            <div class="flex gap-2 mt-3 flex-wrap">
                <button onclick="procesarDictado()" id="btn-procesar" class="flex-1 min-w-[140px] bg-slate-900 hover:bg-slate-700 text-white font-bold px-4 py-3 rounded-xl shadow-sm transition-all active:scale-95">
                    ✨ Procesar
                </button>
                <button onclick="limpiarDictado()" class="bg-slate-200 hover:bg-slate-300 text-slate-700 font-bold px-4 py-3 rounded-xl transition-all text-sm">
                    🗑️ Limpiar
                </button>
            </div>

            <details class="atag-help">
                <summary style="cursor:pointer; font-weight:700;">💡 Cómo dictar (guía rápida)</summary>
                <div style="margin-top:8px; line-height:1.8;">
                    <strong>📝 Tarea normal:</strong><br>
                    <em>"Llamar al fontanero mañana"</em> → agenda
                    <br><br>
                    <strong>🛒 Comando de pedido:</strong><br>
                    <em>"Comprar a Makro atún"</em> → envía a pedidos: producto <strong>atún</strong>, proveedor <strong>Makro</strong>
                    <br><br>
                    <strong>📅 Fechas reconocidas:</strong><br>
                    hoy, mañana, pasado mañana, lunes…domingo, la semana que viene
                    <br><br>
                    <strong>🗣️ Separa tareas con comas o "y":</strong><br>
                    <em>"Llamar al fontanero y comprar a Makro atún"</em>
                </div>
            </details>
        </div>

        <!-- FILTROS Y ACCIONES -->
        <div class="bg-white border border-slate-200 rounded-2xl p-4 shadow-sm space-y-3">
            <div class="flex flex-wrap gap-2 items-center">
                <span class="text-xs font-bold text-slate-500 uppercase mr-1">Ver:</span>
                <button class="filtro-chip active" data-filtro="pendientes" onclick="setFiltro('pendientes')">⏳ Pendientes</button>
                <button class="filtro-chip" data-filtro="todas" onclick="setFiltro('todas')">📋 Todas</button>
                <button class="filtro-chip" data-filtro="hechas" onclick="setFiltro('hechas')">✅ Hechas</button>
            </div>

            <div class="flex flex-wrap gap-2 items-center justify-between">
                <div class="text-xs text-slate-500 font-semibold" id="contador-total"></div>
                <div class="flex gap-2 flex-wrap">
                    <button onclick="imprimirAgenda()" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-3 py-2 rounded-lg text-xs transition-all">
                        🖨️ Imprimir agenda
                    </button>
                    <button onclick="borrarHechas()" class="bg-red-500 hover:bg-red-600 text-white font-bold px-3 py-2 rounded-lg text-xs transition-all">
                        🗑️ Borrar hechas
                    </button>
                </div>
            </div>
        </div>

        <div id="lista-tareas">
            <div class="text-center text-slate-400 py-12 bg-white rounded-2xl border border-slate-200">
                <div class="text-5xl mb-3">🎤</div>
                <div class="text-sm font-medium">Dicta tu primera tarea para empezar</div>
            </div>
        </div>

        <!-- PEDIDOS ENVIADOS -->
        <div class="bg-white border border-slate-200 rounded-2xl p-4 shadow-sm">
            <div class="flex justify-between items-center mb-3 flex-wrap gap-2">
                <h2 class="text-sm font-bold text-slate-700 uppercase tracking-wider flex items-center gap-2">
                    🛒 Pedidos enviados
                    <span id="contador-pedidos" class="bg-blue-100 text-blue-800 text-xs px-2 py-0.5 rounded-full font-bold">0</span>
                </h2>
                <button onclick="borrarPedidosEnviados()" class="bg-slate-200 hover:bg-slate-300 text-slate-700 font-bold text-xs px-3 py-2 rounded-lg transition-all">
                    🗑️ Limpiar
                </button>
            </div>
            <div id="lista-pedidos" class="space-y-2">
                <div class="text-center text-slate-400 text-xs py-3">Sin pedidos enviados aún</div>
            </div>
        </div>

    </main>

    <!-- Contenedor oculto para impresión -->
    <div id="zona-impresion"></div>

    <script>
    // ============================================================
    // TODO LIST SPEECH - Fredware
    // - Agenda por fechas (sin etiquetas)
    // - Comandos de pedido → enviar a módulo de pedidos
    // ============================================================
    const DIAS = ['Domingo','Lunes','Martes','Miércoles','Jueves','Viernes','Sábado'];
    const STORAGE_KEY = 'fredware_todolist_speech';
    const STORAGE_PEDIDOS = 'fredware_todolist_pedidos';

    let tareas = [];
    let pedidosEnviados = [];
    let filtroActual = 'pendientes';
    let reconocimiento = null;
    let escuchando = false;

    // ============================================================
    // PROVEEDORES CONOCIDOS (para detectar el proveedor del pedido)
    // ============================================================
    const PROVEEDORES = [
        'makro', 'pescasa', 'namastelle', 'galicia', 'frutas pepe',
        'cash', 'mercado', 'mercadona', 'carrefour', 'dia', 'lidl',
        'alcampo', 'eroski', 'consum', 'bonpreu', 'caprabo',
        'carnicas', 'pescaderia', 'verduleria', 'panaderia',
        'coca cola', 'mahou', 'heineken', 'estrella galicia'
    ];

    // Palabras que indican pedido
    const PALABRAS_PEDIDO = [
        'comprar', 'compra', 'pedir', 'pedido', 'encargar', 'encargo',
        'reponer', 'reposicion', 'solicitar', 'solicitud', 'adquirir'
    ];

    // ============================================================
    // UTILIDADES
    // ============================================================
    function toast(msg, tipo='success') {
        Swal.fire({
            toast: true, position: 'top-end', icon: tipo,
            title: msg, showConfirmButton: false, timer: 2500,
            timerProgressBar: true
        });
    }
    function esc(t) { return String(t).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
    function pad(n) { return String(n).padStart(2,'0'); }

    function fechaHoy() {
        const d = new Date();
        return `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}`;
    }

    function sumarDias(fechaStr, dias) {
        const d = new Date(fechaStr + 'T00:00:00');
        d.setDate(d.getDate() + dias);
        return `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}`;
    }

    function formatearFecha(f) {
        if (!f) return '';
        const d = new Date(f + 'T00:00:00');
        return `${pad(d.getDate())}/${pad(d.getMonth()+1)}/${d.getFullYear()}`;
    }

    function diaSemana(fechaStr) {
        if (!fechaStr) return '';
        const d = new Date(fechaStr + 'T00:00:00');
        return DIAS[d.getDay()];
    }

    function normalizar(texto) {
        return texto.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    }

    function guardar() {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(tareas));
        localStorage.setItem(STORAGE_PEDIDOS, JSON.stringify(pedidosEnviados));
    }

    function cargar() {
        try {
            const d1 = localStorage.getItem(STORAGE_KEY);
            tareas = d1 ? JSON.parse(d1) : [];
            const d2 = localStorage.getItem(STORAGE_PEDIDOS);
            pedidosEnviados = d2 ? JSON.parse(d2) : [];
        } catch (e) {
            tareas = [];
            pedidosEnviados = [];
        }
    }

    // ============================================================
    // DETECCIÓN DE FECHAS
    // ============================================================
    function detectarFecha(texto) {
        const textoNorm = normalizar(texto);
        const hoy = fechaHoy();

        if (/\bpasado\s+mañana\b/.test(textoNorm)) return { fecha: sumarDias(hoy, 2), coincidencia: 'pasado mañana' };
        if (/\bmañana\b/.test(textoNorm)) return { fecha: sumarDias(hoy, 1), coincidencia: 'mañana' };
        if (/\bhoy\b/.test(textoNorm)) return { fecha: hoy, coincidencia: 'hoy' };
        if (/\bla\s+semana\s+que\s+viene\b/.test(textoNorm)) return { fecha: sumarDias(hoy, 7), coincidencia: 'la semana que viene' };

        const diasMap = {
            'lunes': 1, 'martes': 2, 'miercoles': 3, 'jueves': 4,
            'viernes': 5, 'sabado': 6, 'domingo': 0
        };
        const hoyDate = new Date(hoy + 'T00:00:00');
        const diaHoy = hoyDate.getDay();

        for (const [nombre, numDia] of Object.entries(diasMap)) {
            const regex = new RegExp(`\\b${nombre}\\b`);
            if (regex.test(textoNorm)) {
                let diff = (numDia - diaHoy + 7) % 7;
                if (diff === 0) diff = 7;
                return { fecha: sumarDias(hoy, diff), coincidencia: nombre };
            }
        }

        return { fecha: null, coincidencia: null };
    }

    // ============================================================
    // DETECCIÓN DE URGENTE
    // ============================================================
    function esUrgente(texto) {
        const t = normalizar(texto);
        return ['urgente', 'urgencia', 'corre prisa', 'ya mismo', 'cuanto antes', 'inmediato', 'para ayer'].some(p => t.includes(p));
    }

    // ============================================================
    // DETECCIÓN DE COMANDO PEDIDO
    // Formato esperado: "comprar [a/para/en] PROVEEDOR PRODUCTO"
    //   o: "pedir PRODUCTO a PROVEEDOR"
    // Devuelve { esPedido, producto, proveedor, textoOriginal }
    // ============================================================
    function detectarPedido(texto) {
        const textoNorm = normalizar(texto);
        const palabras = texto.split(/\s+/);

        // Buscar verbo de pedido
        const tieneVerbo = PALABRAS_PEDIDO.some(p => {
            const regex = new RegExp(`\\b${p}\\b`);
            return regex.test(textoNorm);
        });

        if (!tieneVerbo) return { esPedido: false };

        // Buscar proveedor conocido
        let proveedorDetectado = null;
        let proveedorOriginal = null;

        for (const prov of PROVEEDORES) {
            const regex = new RegExp(`\\b${prov.replace(/\s+/g, '\\s+')}\\b`, 'i');
            const match = texto.match(regex);
            if (match) {
                proveedorDetectado = prov;
                proveedorOriginal = match[0];
                break;
            }
        }

        if (!proveedorDetectado) return { esPedido: false };

        // Extraer producto: quitar verbo, preposiciones, proveedor y fechas
        let producto = texto;

        // Quitar verbo inicial
        for (const p of PALABRAS_PEDIDO) {
            const regex = new RegExp(`^\\s*${p}\\s+`, 'i');
            producto = producto.replace(regex, '');
        }

        // Quitar preposiciones "a", "para", "en", "de", "al", "del"
        producto = producto.replace(/\b(a|para|en|de|al|del)\s+/gi, ' ');

        // Quitar el nombre del proveedor
        const regexProv = new RegExp(proveedorOriginal.replace(/\s+/g, '\\s+'), 'gi');
        producto = producto.replace(regexProv, ' ');

        // Quitar fechas
        producto = producto
            .replace(/\b(pasado\s+mañana|la\s+semana\s+que\s+viene|hoy|mañana|lunes|martes|miércoles|miercoles|jueves|viernes|sábado|sabado|domingo)\b/gi, ' ')
            .replace(/\s+/g, ' ')
            .trim();

        // Capitalizar
        if (producto) producto = producto.charAt(0).toUpperCase() + producto.slice(1);

        return {
            esPedido: true,
            producto: producto || '(sin especificar)',
            proveedor: proveedorDetectado,
            proveedorOriginal: proveedorOriginal
        };
    }

    // ============================================================
    // DIVIDIR DICTADO EN TAREAS
    // ============================================================
    function dividirEnTareas(texto) {
        let limpio = texto
            .replace(/^(apunta|apuntar|añade|añadir|anota|anotar|recuerda|recordar|tengo que|hay que)\s+/i, '')
            .trim();

        let partes = limpio
            .split(/[,;]+|\s+y\s+(?=[a-záéíóúñ])/i)
            .map(p => p.trim())
            .filter(p => p.length >= 3);

        if (partes.length === 0 && limpio.length >= 3) partes = [limpio];

        return partes.map(p => {
            let textoLimpio = p
                .replace(/\b(pasado\s+mañana|la\s+semana\s+que\s+viene|hoy|mañana|lunes|martes|miércoles|miercoles|jueves|viernes|sábado|sabado|domingo)\b/gi, '')
                .replace(/\s+/g, ' ')
                .trim();
            if (textoLimpio) textoLimpio = textoLimpio.charAt(0).toUpperCase() + textoLimpio.slice(1);
            return { texto: textoLimpio || p, original: p };
        }).filter(t => t.texto.length >= 3);
    }

    // ============================================================
    // PREVISUALIZACIÓN
    // ============================================================
    function previsualizarDictado() {
        const input = document.getElementById('input-dictado');
        const preview = document.getElementById('preview-deteccion');
        const texto = input.value.trim();

        if (!texto || texto.length < 3) {
            preview.innerHTML = '';
            return;
        }

        const partes = dividirEnTareas(texto);
        if (partes.length === 0) {
            preview.innerHTML = '';
            return;
        }

        const itemsHTML = partes.map(p => {
            const pedido = detectarPedido(p.original);

            if (pedido.esPedido) {
                return `
                    <div class="preview-item pedido">
