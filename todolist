        preview.innerHTML = itemsHTML;
    }

    // ============================================================
    // DICTADO POR VOZ
    // ============================================================
    function initReconocimiento() {
        const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
        if (!SpeechRecognition) return null;

        const rec = new SpeechRecognition();
        rec.lang = 'es-ES';
        rec.continuous = true;
        rec.interimResults = true;

        rec.onstart = () => {
            escuchando = true;
            actualizarBotonMicro();
            mostrarEstadoVoz('escuchando', '🎤 Escuchando... habla ahora');
        };

        rec.onresult = (event) => {
            let interim = '';
            let final = '';

            for (let i = event.resultIndex; i < event.results.length; i++) {
                const transcript = event.results[i][0].transcript;
                if (event.results[i].isFinal) {
                    final += transcript + ' ';
                } else {
                    interim += transcript;
                }
            }

            if (final) {
                const input = document.getElementById('input-dictado');
                input.value = (input.value + ' ' + final).trim();
                previsualizarDictado();
            }

            document.getElementById('transcripcion-interina').textContent = interim ? `"${interim}"` : '';
        };

        rec.onerror = (event) => {
            let msg = '❌ Error de reconocimiento';
            if (event.error === 'no-speech') msg = '🔇 No se detectó voz. Inténtalo de nuevo.';
            else if (event.error === 'audio-capture') msg = '🎤 No se encontró micrófono.';
            else if (event.error === 'not-allowed') msg = '🚫 Permiso de micrófono denegado.';
            else if (event.error === 'network') msg = '🌐 Error de red.';

            mostrarEstadoVoz('error', msg);
            escuchando = false;
            actualizarBotonMicro();
        };

        rec.onend = () => {
            escuchando = false;
            actualizarBotonMicro();
            document.getElementById('transcripcion-interina').textContent = '';
            const estado = document.getElementById('estado-voz');
            if (estado.classList.contains('escuchando')) {
                mostrarEstadoVoz('ok', '✅ Dictado detenido');
                setTimeout(() => estado.classList.remove('visible'), 2000);
            }
        };

        return rec;
    }

    function toggleDictado() {
        if (!reconocimiento) {
            reconocimiento = initReconocimiento();
            if (!reconocimiento) {
                Swal.fire({
                    icon: 'error',
                    title: 'Navegador no compatible',
                    html: `
                        <p>Tu navegador no soporta reconocimiento de voz.</p>
                        <p style="margin-top:10px; font-size:13px; color:#64748b;">
                            Prueba con <strong>Chrome</strong>, <strong>Edge</strong> o <strong>Safari</strong>.
                        </p>
                        <p style="margin-top:10px; font-size:12px; color:#94a3b8;">
                            Mientras tanto, puedes escribir directamente en el cuadro de texto.
                        </p>
                    `,
                    confirmButtonText: 'Entendido'
                });
                return;
            }
        }

        if (escuchando) {
            reconocimiento.stop();
        } else {
            try {
                reconocimiento.start();
            } catch (e) {
                console.warn('Error iniciando reconocimiento:', e);
            }
        }
    }

    function actualizarBotonMicro() {
        const btn = document.getElementById('btn-micro');
        if (escuchando) {
            btn.classList.add('escuchando');
            btn.innerHTML = '⏹️';
            btn.title = 'Pulsa para detener';
        } else {
            btn.classList.remove('escuchando');
            btn.innerHTML = '🎤';
            btn.title = 'Pulsa para dictar';
        }
