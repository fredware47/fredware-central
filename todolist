    function actualizarBotonUsuario() {
        const nombre = localStorage.getItem('fredware_usuario') || '';
        const btn = document.getElementById('btn-usuario');
        if (nombre) {
            btn.innerHTML = '👤 ' + esc(nombre);
            btn.className = 'bg-emerald-100 text-emerald-800 px-4 py-2 rounded-xl text-xs font-bold transition-all hover:bg-emerald-200';
        } else {
            btn.innerHTML = '👤 Poner nombre';
            btn.className = 'bg-amber-100 text-amber-800 px-4 py-2 rounded-xl text-xs font-bold transition-all hover:bg-amber-200';
        }
    }

    // ============================================================
    // INICIALIZACIÓN
    // ============================================================
    document.getElementById('btn-usuario').addEventListener('click', editarUsuario);

    document.addEventListener('DOMContentLoaded', () => {
        actualizarBotonUsuario();
        cargar();
        renderTareas();
        renderPedidos();

        const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
        if (!SpeechRecognition) {
            mostrarEstadoVoz('error', '⚠️ Tu navegador no soporta dictado por voz. Usa Chrome, Edge o Safari. Puedes escribir manualmente.');
        } else {
            reconocimiento = initReconocimiento();
        }
    });
    </script>
</body>
</html>
