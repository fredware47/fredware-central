                </div>
            `,
            showCancelButton: true,
            confirmButtonText: '💾 Guardar',
            cancelButtonText: 'Cancelar',
            confirmButtonColor: '#1e293b',
            preConfirm: () => ({
                texto: document.getElementById('edit-texto').value.trim(),
